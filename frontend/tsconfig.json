{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "*": ["./*"]
    }
  },
  "include": ["src/**/*", "index.html"],
  "exclude": ["node_modules", "dist"]
}